# Formatting every editor applies, and the format stage of scripts/test/run_checks.py enforces.
# The language formatters own the details inside each language: rustfmt for Rust, and for
# Kotlin and TypeScript the formatter their first task chooses (docs/engineering/CONVENTIONS.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[*.{rs,kt,kts,ts,tsx,py,sh,toml,lcl.txt}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.rs]
# rustfmt's width.
max_line_length = 100

[*.{py,sh}]
max_line_length = 120
